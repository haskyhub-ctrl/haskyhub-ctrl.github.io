# Mẫu cấu hình cho máy chủ. Sao chép thành backend/.env rồi điền giá trị thật.
# File .env KHÔNG được đưa lên git (đã nằm trong .gitignore).

# --- AI phân tích khảo sát và chatbot (qua cổng 9router) ---
NINEROUTER_BASE_URL=http://<dia-chi-9router>:20128/v1
NINEROUTER_API_KEY=
# Chatbot dùng cặp ROUTER_*; để giống hai dòng trên
ROUTER_BASE_URL=http://<dia-chi-9router>:20128/v1
ROUTER_API_KEY=
ROUTER_MODEL=ag/gemini-3.8-flash-high
GEMINI_MODEL=ag/gemini-3.8-flash

# --- Gemini trực tiếp (dự phòng, nhúng tài liệu RAG) ---
GEMINI_API_KEY=

# --- Telegram báo cháy 114 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bảo mật ---
# BẮT BUỘC đặt chuỗi ngẫu nhiên riêng (tạo bằng: openssl rand -hex 32). Để trống hoặc dùng giá trị mặc định
# trong mã nguồn thì ai cũng giả mạo được phiên đăng nhập, kể cả quản trị viên.
SECRET_KEY=
# Mật khẩu CSDL nếu dùng PostgreSQL
# DATABASE_URL=postgresql://frasuser:<mat-khau>@localhost:5432/fras
# Đặt một lần để đổi mật khẩu quản trị; sau đó xóa dòng này
# ADMIN_PASSWORD=
